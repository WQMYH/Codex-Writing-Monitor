{
  "mcpServers": {
    "writing-ops": {
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "./scripts/run-mcp.ps1"
      ],
      "cwd": ".",
      "enabled": true,
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 120,
      "default_tools_approval_mode": "prompt",
      "tools": {
        "writing_dashboard": {
          "approval_mode": "auto"
        },
        "writing_goal_get": {
          "approval_mode": "auto"
        },
        "writing_runtime_status": {
          "approval_mode": "auto"
        },
        "writing_run_get": {
          "approval_mode": "auto"
        },
        "writing_trace_get": {
          "approval_mode": "auto"
        },
        "writing_milestone_get": {
          "approval_mode": "auto"
        },
        "writing_run_due": {
          "approval_mode": "auto"
        }
      }
    }
  }
}
